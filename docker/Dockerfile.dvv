# dvv-stage image, built from the pixi lock. Build context: repo root.
#   docker build -f docker/Dockerfile.dvv -t dvv-cloud:dvv .
#   docker buildx build --platform linux/amd64,linux/arm64 ...   (both arches)
#
# WHY PIXI AND NOT PIP. The previous image was pip-on-python:3.10-slim, which
# is x86-only: obspy publishes no linux/aarch64 wheel on PyPI at any version
# through 1.5.1, so an arm64 build fell back to compiling it and failed with no
# gcc in the image. conda-forge DOES ship obspy for linux-aarch64 (1.4.2-1.5.1),
# so building from the lock gets arm64 -- and therefore Fargate Graviton, which
# is cheaper per vCPU than x86 for the same shape.
#
# The lock is the contract: `--locked` fails rather than re-solving, so the
# image runs the versions the laptop and CI resolved, not whatever PyPI serves
# on build day. That is also what makes the two stages reproducible separately
# (noisepy-seis pins pandas<2, codameter needs pandas>=2 -- they cannot share an
# environment, which is why there are two images at all).
FROM ghcr.io/prefix-dev/pixi:0.76.2-bookworm-slim AS build

WORKDIR /code
COPY pyproject.toml pixi.lock README.md ./
COPY src ./src

RUN pixi install --locked -e dvv-image \
 && pixi shell-hook -e dvv-image -s bash > /shell-hook.sh \
 && echo 'exec "$@"' >> /shell-hook.sh \
 && rm -rf /root/.cache/rattler

# The runtime stage carries the solved environment and nothing that built it:
# no pixi binary, no package cache, no solver.
FROM debian:bookworm-slim AS runtime

WORKDIR /code
COPY --from=build /code/.pixi/envs/dvv-image /code/.pixi/envs/dvv-image
COPY --from=build /shell-hook.sh /shell-hook.sh
# the editable install resolves against /code/src, so the path must match the
# build stage's WORKDIR
COPY --from=build /code/src /code/src
COPY --from=build /code/pyproject.toml /code/README.md /code/

ENTRYPOINT ["/bin/bash", "/shell-hook.sh", "python", "-m", "noisepy_dvv_cloud"]
