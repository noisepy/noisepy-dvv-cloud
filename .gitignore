# Filled-in copies of the config skeletons: these carry real role ARNs,
# subnet and security-group IDs. The tracked configs/*.yaml stay templates.
configs/*.local.yaml
configs/*.local.json

# ---------------------------------------------------------------------------
# Credential material. Nothing here has ever been committed (verified across
# all 21 commits on every ref, 2026-09-11) and the point is to keep it that
# way: `git add -A` is used routinely in this repo, so a dropped key or a
# stray .env must not be stageable in the first place.
#
# AWS credentials for this project live in the environment or in
# ~/.aws/credentials OUTSIDE the repo -- never in a tracked file. Role ARNs
# come from DVV_JOB_ROLE_ARN / DVV_EXECUTION_ROLE_ARN; see parameters.py.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
.envrc
.aws/
.aws-sam/
credentials
credentials.*
aws_credentials*
*.pem
*.key
*.p12
*.pfx
*.ppk
*.jks
*.keytab
id_rsa*
id_ecdsa*
id_ed25519*
.netrc
.pypirc
*secret*.json
*secret*.yaml
*secret*.yml
*.tfstate
*.tfstate.*
.terraform/

# Logs can carry tokens, presigned URLs and account identifiers in tracebacks.
*.log
